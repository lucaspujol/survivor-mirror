POSTGRES_USER=geoemploi
POSTGRES_PASSWORD=geoemploi
POSTGRES_DB=geoemploi
POSTGRES_HOST_PORT=5433

# Signs the auth JWTs. Placeholder so `cp .env.example .env` gives a working
# stack; replace it with your own before anything leaves localhost:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-not-a-real-secret
JWT_EXPIRE_DAYS=7
# Set to true once served over https.
COOKIE_SECURE=false

# The stack runs mailpit, which captures the notification mails and serves
# them on this port instead of delivering them. Nothing ever leaves the
# machine.
MAILPIT_UI_PORT=8025
# Link the notification mails point back to.
APP_BASE_URL=http://localhost:5173
